# Required: MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/ledger

# Optional: MongoDB Search (Atlas Search). Keep disabled until all five search
# indexes have been created with `pnpm search:indexes` on the intended cluster.
MONGODB_SEARCH_ENABLED=false
MONGODB_SEARCH_INDEX=easyrakh_search
# Optional comma-separated subset. Leave empty when all five indexes exist.
MONGODB_SEARCH_COLLECTIONS=

# Required: Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Required: authentication
# Generate with: openssl rand -base64 32
JWT_SECRET=replace-with-a-secure-random-secret

# Required: Cloudinary uploads and production builds
CLOUDINARY_CLOUD_NAME=replace-with-your-cloud-name
CLOUDINARY_API_KEY=replace-with-your-api-key
CLOUDINARY_API_SECRET=replace-with-your-api-secret

# Optional: Google Gemini voice assistant
GEMINI_API_KEY=

# Optional: password-reset emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional: comma-separated registered accounts allowed to view admin usage
# Example: ADMIN_EMAILS=owner@example.com,manager@example.com
ADMIN_EMAILS=
